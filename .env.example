# WorkBuddy2API 配置
# 可通过环境变量覆盖，或复制为 .env

# 监听地址与端口
HOST=127.0.0.1
PORT=8787

# 对外 /v1/* 端点鉴权：使用在 WebUI「应用」页创建的 sk- 应用 Key（Bearer 认证），
# 不依赖此环境变量。每条使用记录按应用追溯。
# API_KEY=

# 管理接口（WebUI/admin）鉴权 Token。为空则仅允许本机回环访问管理接口；
# 若需从局域网/公网访问 WebUI，请设置此值（需 Bearer 或 X-Admin-Token 头）
ADMIN_TOKEN=

# 本地 auth 文件目录（留空自动探测 CodeBuddyExtension/.../auth 与项目 auths/）
AUTH_DIR=

# SQLite 数据库文件（相对路径以项目根目录 Workbuddy2API/ 为基准）
DB_PATH=data/workbuddy.db

# 腾讯后端
BACKEND=https://copilot.tencent.com
DOMAIN=www.codebuddy.cn

# 使用记录保留天数
USAGE_RETENTION_DAYS=90

# 每日自动签到小时（多个用逗号分隔）
CHECKIN_HOURS=9,21
# 额度刷新间隔（分钟）
CREDIT_REFRESH_MIN=30
# 每日自动刷新模型目录的小时（0-23，可在 WebUI 设置里改）
MODEL_REFRESH_HOUR=6
# 每日 token 保活小时（0-23，可在 WebUI 设置里改）
KEEPALIVE_HOUR=22

# 反审核脱敏（默认开启）
DESENSITIZE=1
# 账号级限速反封号（默认开启）
RATELIMIT=1
# 请求最小间隔（秒）
RATELIMIT_INTERVAL=1.5
