# WorkBuddy2API 配置
# 可通过环境变量覆盖，或复制为 .env

# 监听地址与端口
HOST=127.0.0.1
PORT=8787

# 对外 /v1/* 端点鉴权：使用在 WebUI「应用」页创建的 sk- 应用 Key（Bearer 认证），
# 不使用环境变量。每条使用记录按应用追溯。

# 管理接口（WebUI/admin）鉴权 Token。为空则仅允许本机回环访问管理接口；
# 若需从局域网/公网访问 WebUI，请设置此值（需 Bearer 或 X-Admin-Token 头）
ADMIN_TOKEN=

# 本地 auth 文件目录（留空自动探测 CodeBuddyExtension/.../auth 与项目 auths/）
AUTH_DIR=

# SQLite 数据库文件（相对路径以项目根目录 Workbuddy2API/ 为基准）
DB_PATH=data/workbuddy.db

# ── 下面三项（BACKEND / WORKBUDDY_EXE / PROXY）也可以在 WebUI 里改 ──
# 路径：账号 → 设置 → 区域与网络。**WebUI 里填的值优先于这里的环境变量**；
# 在 WebUI 里留空 = 回落到这里的环境变量（再留空则自动判定/直连）。
# 改完即时生效，不需要重启进程。

# 上游后端 host。**推荐留空**：留空时按每个账号 auth 文件里的 domain 自动选择
# 区域（国内版 copilot.tencent.com / 国际版 www.workbuddy.ai），支持国内外账号混池。
# 仅当需要强制所有账号打同一个 host（自建/特殊部署）时才填，填了对所有区域生效。
# ⚠️ 国内外混池时填了它，会让另一区域的账号全部不可用。
BACKEND=

# auth 文件缺失 domain 字段时的兜底域名；同时决定「默认区域 = 国内版」的判定
DOMAIN=www.codebuddy.cn

# 官方 WorkBuddy 客户端可执行文件路径。**一般留空**：留空按平台默认位置探测
# （Windows: %LOCALAPPDATA%\Programs\WorkBuddy\WorkBuddy.exe；macOS: /Applications/WorkBuddy.app/...）。
# 仅在自动探测不到、而你需要解密 $wbEncrypted 加密登录态时才填。
# 说明：桌面端 5.6.0+ 会把 accessToken/refreshToken 加密落盘，密钥只存在于官方客户端内部，
# 网关必须借它的 native binding 才能解出明文；解不开时会给出明确报错（而不是静默登录失效）。
WORKBUDDY_EXE=

# 出站代理（如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080）。**留空 = 直连**。
# 注意：网关刻意不读取 HTTP_PROXY/ALL_PROXY 等环境变量（Docker/CI 里这些值常常无效或
# 指向内网，会导致本该直连的请求解析出坏代理），需要代理必须在这里显式配置。
PROXY=

# 出站客户端身份 User-Agent。**强烈建议留空**：留空时按账号区域自动使用官方客户端
# 身份（国内版 `CLI/2.139.0 CodeBuddy/2.139.0` / 国际版 `WorkBuddy/5.4.2`）。
# 上游会从 UA 里解析客户端版本号，解析不出会直接拒绝（`400 code=12403 check ua`），
# 而且**同一个账号换 UA 会拿到不同的模型目录**（国际版桌面端身份比 CLI 身份多出
# deepseek-v4.1-flash-sg / hy4-preview-f；国内版反过来，桌面端身份的 cli 白名单为空）。
# 这一项只在"官方 UA 被临时封禁"这种救急场景才需要填。
USER_AGENT=

# 使用记录保留天数
USAGE_RETENTION_DAYS=90

# 每日自动签到小时（多个用逗号分隔）
CHECKIN_HOURS=9,21
# 额度刷新间隔（分钟）
CREDIT_REFRESH_MIN=30
# 每日自动刷新模型目录的小时（0-23，可在 WebUI 设置里改）
MODEL_REFRESH_HOUR=6
# 模型缓存 TTL（分钟，推理端点 /v1/models 惰性刷新的新鲜度上限，可在 WebUI 设置里改）
MODEL_TTL_MIN=60
# 每日 token 保活小时（0-23，可在 WebUI 设置里改）
KEEPALIVE_HOUR=22

# 反审核脱敏（默认开启）
DESENSITIZE=1
# 账号级限速反封号（默认开启）
RATELIMIT=1
# 请求最小间隔（秒）
RATELIMIT_INTERVAL=1.5
